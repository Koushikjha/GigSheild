# GigShield backend base URL (Spring Boot). In docker-compose this is the
# `backend` service; for local `npm run dev` against a locally-running
# backend, http://localhost:8080 is the default if this is unset.
VITE_API_BASE_URL=http://localhost:8080

# Razorpay *public* key id (safe to ship in a frontend build — it is not a
# secret; the secret key only ever lives in the backend's application-secrets.yml).
# Leave unset to run BuyPolicy in simulated-checkout mode (useful for demos
# without a Razorpay test account) — the real activation always happens
# through the webhook regardless of which path this takes.
VITE_RAZORPAY_KEY_ID=
