# GigShield — root .gitignore
# Covers all three services (gigshield-backend, gigshield-ml, gigshield-frontend)
# since they're pushed together as one repo.

# ── Secrets / local env overrides ───────────────────────────────────────────
# .env.example stays tracked — it's the template. Only real, local .env files
# (which may carry real Razorpay/JWT/SMS secrets) are ignored.
.env
.env.local
.env.*.local
*.pem
*.key
# Note: gigshield-backend/src/main/resources/application-secrets.yml is
# DELIBERATELY tracked, not ignored — it ships committed *dev-only*
# placeholder secrets (see gigshield-backend/README.md "Configuration") so a
# first-time clone can `docker compose up` with zero setup. Nothing above
# matches it (it's a .yml file, not .env/.pem/.key). Do not add real
# production secrets to it — override via environment variables instead.

# ── gigshield-backend (Java / Maven) ────────────────────────────────────────
gigshield-backend/src/main/resources/application-secrets.yml
gigshield-backend/target/
gigshield-backend/**/*.class
gigshield-backend/logs/
gigshield-backend/*.log
# Maven wrapper jar is fetched by mvnw on first run — not committed.
gigshield-backend/.mvn/wrapper/maven-wrapper.jar

# ── gigshield-ml (Python) ────────────────────────────────────────────────────
gigshield-ml/__pycache__/
gigshield-ml/**/__pycache__/
gigshield-ml/*.pyc
gigshield-ml/**/*.pyc
gigshield-ml/.venv/
gigshield-ml/venv/
gigshield-ml/*.egg-info/
# Trained model artifacts — large binaries, regenerated by
# entrypoint.sh/train_all.py on first boot. Not meant to be versioned.
gigshield-ml/models/*.pkl
gigshield-ml/.pytest_cache/

# ── gigshield-frontend (Node / Vite) ─────────────────────────────────────────
gigshield-frontend/node_modules/
gigshield-frontend/dist/
gigshield-frontend/.vite/
gigshield-frontend/*.local

# ── Docker / compose ─────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp

# ── Misc build artifacts that don't belong in source control ────────────────
*.zip
*.tar.gz
