# Copy to .env to override docker-compose defaults. Both variables are
# optional — docker-compose.yml already has working dev-only defaults.

# Signing key for access/refresh JWTs (min 32 chars). Change this for
# anything beyond local/demo use — the compose default is intentionally
# a placeholder, same as gigshield-backend's own application-dev.yml.
JWT_SECRET=dev-only-secret-key-minimum-32-characters-long!!

# Razorpay *public* key id, baked into the frontend build. Leave blank to
# run BuyPolicy in simulated-checkout mode (no Razorpay account needed).
VITE_RAZORPAY_KEY_ID=
